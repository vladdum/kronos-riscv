digraph hazard_forward {
  // ────────────────────────────────────────────────────────────────
  // Hazard & Forwarding plane.
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  //
  // Goal of this layout: separate the two bundles so dashed arrows
  // don't overlap.
  //   - kronos_hazard sits BELOW the pipe row (yellow bundle down)
  //   - kronos_forward sits ABOVE the pipe row (amber bundle up)
  //   That way the two fan-outs use disjoint vertical lanes.
  //
  //   y=800: kronos_forward (above pipe row)
  //   y=520: pipeline register row
  //   y=330: kronos_hazard  (below pipe row)
  //   y=180: combined_stall OR
  //   y= 60: stall sources
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 16,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 12,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="720,980!", label="Hazard & Forwarding Plane",
         shape=plaintext, style="", fontsize=24, fontcolor="#111827"];

  // ── Pipeline registers (middle row) ────────────────────────────
  pc_reg  [pos="260,520!", label="PC",
           fillcolor="#dbeafe", color="#3b82f6", penwidth=3, fontsize=16,
           width=1.3, height=0.7, fixedsize=true];
  if_id   [pos="520,520!", label="IF/ID",
           fillcolor="#9ca3af", color="#6b7280", fontsize=16,
           width=1.3, height=0.7, fixedsize=true];
  id_ex   [pos="780,520!", label="ID/EX",
           fillcolor="#9ca3af", color="#6b7280", fontsize=16,
           width=1.3, height=0.7, fixedsize=true];
  ex_mem  [pos="1040,520!", label="EX/MEM",
           fillcolor="#9ca3af", color="#6b7280", fontsize=16,
           width=1.4, height=0.7, fixedsize=true];
  mem_wb  [pos="1300,520!", label="MEM/WB",
           fillcolor="#9ca3af", color="#6b7280", fontsize=16,
           width=1.4, height=0.7, fixedsize=true];

  // Thin datapath line between pipe regs
  pc_reg -> if_id   [color="#9ca3af", penwidth=1, arrowhead=none, tailport=e, headport=w];
  if_id  -> id_ex   [color="#9ca3af", penwidth=1, arrowhead=none, tailport=e, headport=w];
  id_ex  -> ex_mem  [color="#9ca3af", penwidth=1, arrowhead=none, tailport=e, headport=w];
  ex_mem -> mem_wb  [color="#9ca3af", penwidth=1, arrowhead=none, tailport=e, headport=w];

  // ── kronos_forward (ABOVE pipe row) ───────────────────────────
  forward [pos="780,800!",
           label="kronos_forward\nFWD_NONE | EXMEM | MEMWB select\nin:  ex_mem.rd/wen, mem_wb.rd/wen\n     id_ex.rs1, rs2\nout: fwd_rs1_sel, fwd_rs2_sel → id_ex",
           fillcolor="#fef08a", color="#facc15",
           fontcolor="#713f12", fontsize=12, penwidth=3,
           width=4.4, height=1.9, fixedsize=true];

  // ── kronos_hazard (BELOW pipe row) ────────────────────────────
  hazard  [pos="780,330!",
           label="kronos_hazard\nstall / flush logic\nin:  id_ex.rd, is_load, valid\n     if_id.rs1, rs2\nout: pc_en, if_id/id_ex flush\n     ex_mem/mem_wb enables",
           fillcolor="#fef08a", color="#facc15",
           fontcolor="#713f12", fontsize=12, penwidth=3,
           width=4.0, height=1.9, fixedsize=true];

  // ── Combined stall OR ──────────────────────────────────────────
  stall_or [pos="220,180!",
            label="combined_stall\nmem_stall | muldiv_stall | fetch_stall",
            fillcolor="#fef9c3", color="#eab308", fontcolor="#713f12",
            fontsize=13, width=3.8, height=1.0, fixedsize=true];

  // ── Stall sources (bottom row) ─────────────────────────────────
  mem_stall_src    [pos="60,60!",  label="mem_stall\n(LSU busy)",
                    fillcolor="#ffedd5", color="#f97316", fontsize=13,
                    width=1.8, height=0.8, fixedsize=true];
  muldiv_stall_src [pos="240,60!", label="muldiv_stall\n(MUL/DIV busy)",
                    fillcolor="#fee2e2", color="#ef4444", fontsize=13,
                    width=1.8, height=0.8, fixedsize=true];
  fetch_stall_src  [pos="420,60!", label="instr_fetch_stall\n(align empty)",
                    fillcolor="#dbeafe", color="#3b82f6", fontsize=13,
                    width=1.8, height=0.8, fixedsize=true];

  // ── Stall OR fan-in ────────────────────────────────────────────
  mem_stall_src    -> stall_or [color="#f97316", tailport=n, headport=s];
  muldiv_stall_src -> stall_or [color="#ef4444", tailport=n, headport=s];
  fetch_stall_src  -> stall_or [color="#3b82f6", tailport=n, headport=s];
  stall_or         -> hazard   [color="#eab308", penwidth=3, tailport=e, headport=w];

  // ── Hazard bundle (yellow dashed, BELOW pipe row) ─────────────
  // Inputs: pipe regs south → hazard north.
  if_id -> hazard [color="#eab308", style=dashed, tailport=s, headport=nw];
  id_ex -> hazard [color="#eab308", style=dashed, tailport=s, headport=n];

  // Outputs: hazard north → pipe regs south. Spread exit points so
  // the 5 arrows don't stack on one trunk.
  hazard -> pc_reg [color="#eab308", style=dashed, tailport=nw, headport=s];
  hazard -> if_id  [color="#eab308", style=dashed, tailport=nw, headport=s];
  hazard -> id_ex  [color="#eab308", style=dashed, tailport=n,  headport=s];
  hazard -> ex_mem [color="#eab308", style=dashed, tailport=ne, headport=s];
  hazard -> mem_wb [color="#eab308", style=dashed, tailport=ne, headport=s];

  // ── Forward bundle (amber dashed, ABOVE pipe row) ─────────────
  // Inputs: pipe regs north → forward south. Disjoint from hazard.
  id_ex  -> forward [color="#ca8a04", style=dashed, tailport=n, headport=sw];
  ex_mem -> forward [color="#ca8a04", style=dashed, tailport=n, headport=s];
  mem_wb -> forward [color="#ca8a04", style=dashed, tailport=n, headport=se];

  // Forward output → ID/EX (south face, separate lane from inputs)
  forward -> id_ex [color="#ca8a04", style=dashed, constraint=false,
                    tailport=sw, headport=n];
}
