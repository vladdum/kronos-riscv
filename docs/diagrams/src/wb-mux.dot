digraph wb_mux {
  // ────────────────────────────────────────────────────────────────
  // WB Stage — Writeback mux.
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  //
  //   Left column  (x=120): MEM/WB source fields stacked
  //   Middle       (x=520): wb_mux diamond
  //   Right column (x=920): 3 consumers stacked
  // Edge labels omitted — box labels + color convey meaning.
  // The WB_* select names are listed on the wb_mux face instead.
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 18,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 14,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="520,600!", label="WB Stage — Writeback Mux",
         shape=plaintext, style="", fontsize=24, fontcolor="#111827"];

  // MEM/WB group label
  mem_wb_label [pos="120,540!", label="MEM/WB register",
                shape=plaintext, style="", fontsize=16, fontcolor="#374151"];

  // Four sources (gray pipe-register fields) — names include the select value
  alu_src [pos="120,450!", label="alu_result  (WB_ALU)",
           fillcolor="#e5e7eb", color="#9ca3af", fontsize=15,
           width=2.6, height=0.6, fixedsize=true];
  lsu_src [pos="120,370!", label="lsu_rdata  (WB_MEM)",
           fillcolor="#e5e7eb", color="#9ca3af", fontsize=15,
           width=2.6, height=0.6, fixedsize=true];
  pc_src  [pos="120,290!", label="pc+2 | pc+4  (WB_PC)",
           fillcolor="#e5e7eb", color="#9ca3af", fontsize=15,
           width=2.6, height=0.6, fixedsize=true];
  csr_src [pos="120,210!", label="csr_rdata  (WB_CSR)",
           fillcolor="#e5e7eb", color="#9ca3af", fontsize=15,
           width=2.6, height=0.6, fixedsize=true];

  // Writeback mux — rounded box so ortho arrows land flush on the
  // left/right faces (diamond shape leaves gaps with ortho routing).
  // Tall mux — spans all 4 source y-levels so every arrow lands on
  // its own y-band of the west face (no routing over the top/bottom).
  wb_mux [pos="520,330!", label="WB mux\nsel = wb_sel[1:0]",
          shape=box, style="filled,rounded",
          fillcolor="#e9d5ff", color="#a855f7",
          fontcolor="#4a044e", penwidth=3, fontsize=18,
          width=2.4, height=3.8, fixedsize=true];

  // Three consumers on the right
  regfile_wr [pos="920,450!", label="kronos_regfile\nwrite port\n(rd ← wb_result)",
              fillcolor="#f3e8ff", color="#a855f7", fontsize=14,
              width=2.6, height=1.0, fixedsize=true];
  bypass_out [pos="920,330!", label="WB → ID bypass\n(id_stage bypass_mux)",
              fillcolor="#f3e8ff", color="#a855f7", fontsize=14,
              width=2.6, height=1.0, fixedsize=true];
  fwd_out    [pos="920,210!", label="EX forwarding\nFWD_MEMWB path",
              fillcolor="#f3e8ff", color="#a855f7", fontsize=14,
              width=2.6, height=1.0, fixedsize=true];

  // Edges — source arrows exit east, enter mux on distinct y-bands
  // of its west face (nw/w/w/sw) so none overlap.
  alu_src -> wb_mux [tailport=e, headport=nw];
  lsu_src -> wb_mux [tailport=e, headport=w];
  pc_src  -> wb_mux [tailport=e, headport=w];
  csr_src -> wb_mux [tailport=e, headport=sw];

  wb_mux -> regfile_wr [penwidth=3, tailport=e, headport=w];
  wb_mux -> bypass_out [color="#a855f7", style=dashed, tailport=e, headport=w];
  wb_mux -> fwd_out    [color="#a855f7", style=dashed, tailport=e, headport=w];
}
