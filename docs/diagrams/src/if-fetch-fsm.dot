digraph if_fetch_fsm {
  // ────────────────────────────────────────────────────────────────
  // IF Stage — Fetch FSM (2 states).
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  // Edge labels pinned as plaintext nodes to avoid xlabel collisions.
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 18,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 14,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="450,520!", label="IF Stage — Fetch FSM",
         shape=plaintext, style="", fontsize=24, fontcolor="#111827"];

  // Reset stub on the left
  reset [pos="60,330!", label="rst_ni\ndeasserted",
         fillcolor="#f5f5f5", color="#9ca3af", fontsize=14,
         width=1.4, height=0.7, fixedsize=true];

  // States — two ellipses on a single y-row
  FETCH_IDLE   [pos="260,330!", label="FETCH_IDLE",
                shape=ellipse, fillcolor="#dbeafe", color="#3b82f6",
                penwidth=3, fontsize=22,
                width=2.6, height=1.2, fixedsize=true];
  FETCH_WAIT_R [pos="700,330!", label="FETCH_WAIT_R",
                shape=ellipse, fillcolor="#fee2e2", color="#ef4444",
                penwidth=3, fontsize=22,
                width=2.8, height=1.2, fixedsize=true];

  // Output annotations below each state
  idle_out [pos="260,180!",
            label="ar_valid = align_needs_fetch\nr_ready  = 0",
            shape=plaintext, style="", fontsize=14, fontcolor="#1e3a8a"];
  wait_out [pos="700,180!",
            label="ar_valid = 0\nr_ready  = 1\nrdata → kronos_align",
            shape=plaintext, style="", fontsize=14, fontcolor="#7f1d1d"];

  // Pinned edge labels (above/below each arrow segment)
  //   top arrow  (IDLE→WAIT_R)  at y≈360 via constraint=false routing
  //   bottom arrow (WAIT_R→IDLE) at y≈300
  lbl_go   [pos="480,410!", label="ar_valid & ar_ready",
            shape=plaintext, style="", fontsize=14, fontcolor="#166534"];
  lbl_back [pos="480,250!", label="r_valid",
            shape=plaintext, style="", fontsize=14, fontcolor="#9a3412"];

  // Note at bottom
  note [pos="480,70!",
        label="instr_fetch_stall = ~align_instr_valid   •   PC frozen until r_valid   •   align_needs_fetch=0 in BUFFERED → no re-fetch",
        shape=box, style="filled,rounded",
        fillcolor="#fef9c3", color="#eab308", fontsize=12,
        width=11.0, height=0.6, fixedsize=true];

  // Edges (unlabeled — labels pinned above)
  reset        -> FETCH_IDLE   [color="#6b7280"];
  FETCH_IDLE   -> FETCH_WAIT_R [color="#22c55e", penwidth=3];
  FETCH_WAIT_R -> FETCH_IDLE   [color="#f97316", penwidth=3, constraint=false];
}
