digraph ex_stage {
  // ────────────────────────────────────────────────────────────────
  // EX Stage — three horizontal lanes.
  //
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  //
  //   y=440:  ALU lane  — FWD A → Op A → ALU → Branch → [pc_reg, EX/MEM]
  //   y=300:  Center    — ID/EX (left), res_mux (center), EX/MEM (right)
  //   y=160:  MULDIV    — FWD B → Op B → MULDIV → res_mux
  //   y=40:   CSR/trap  — trap → CSR → EX/MEM
  //
  // Branch resolution sits east of ALU on the same lane (y=440).
  // res_mux sits between the ALU and MULDIV result paths at y=300.
  // EX/MEM register is directly below Branch at (1440,300).
  //
  // Both execution units receive both operands (A and B).
  // Cross-connections are omitted for clarity — see RTL for detail.
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 14,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 12,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="900,740!", label="EX Stage — Operand Muxes, ALU, MUL/DIV, Branch, CSR",
         shape=plaintext, style="", fontsize=20, fontcolor="#7f1d1d"];

  // Stage label
  ex_label [pos="900,680!", label="EX Stage",
            shape=plaintext, style="", fontsize=22, fontcolor="#7f1d1d"];

  // ── Pipeline registers ───────────────────────────────────────────
  id_ex_reg [pos="80,300!", label="ID/EX",
             fillcolor="#9ca3af", color="#6b7280", fontsize=18,
             width=1.4, height=0.7, fixedsize=true];
  ex_mem_reg [pos="1440,300!", label="EX/MEM",
              fillcolor="#9ca3af", color="#6b7280", fontsize=16,
              width=1.4, height=0.7, fixedsize=true];
  pc_reg [pos="1660,440!",
          label="IF PC Register\n(redirect target)",
          fillcolor="#dbeafe", color="#3b82f6", fontsize=13,
          width=2.0, height=0.9, fixedsize=true];

  // ── Forwarding inputs (left side, adjacent to their primary targets) ──
  ex_mem_fwd [pos="160,440!", label="EX/MEM fwd\nalu_result / rd",
              fillcolor="#fecaca", color="#f87171", fontsize=13,
              width=2.0, height=0.9, fixedsize=true];
  mem_wb_fwd [pos="160,160!", label="MEM/WB fwd\nwb_result / rd",
              fillcolor="#e9d5ff", color="#a855f7", fontsize=13,
              width=2.0, height=0.9, fixedsize=true];

  // ── ALU lane (y=440) ─────────────────────────────────────────────
  fwd_rs1 [pos="400,440!",
           label="FWD mux A\nFWD_NONE | EXMEM | MEMWB",
           fillcolor="#fecaca", color="#f87171", fontsize=12,
           width=3.0, height=0.9, fixedsize=true];
  op_a_mux [pos="680,440!",
            label="Operand A mux\nuse_pc ? PC : fwd_rs1",
            fillcolor="#fecaca", color="#f87171", fontsize=12,
            width=2.4, height=0.9, fixedsize=true];
  alu [pos="960,440!",
       label="kronos_alu\nRV32I integer ops",
       fillcolor="#fecaca", color="#f87171", fontsize=13,
       width=2.2, height=0.9, fixedsize=true];

  // ── MULDIV lane (y=160) ──────────────────────────────────────────
  fwd_rs2 [pos="400,160!",
           label="FWD mux B\nFWD_NONE | EXMEM | MEMWB",
           fillcolor="#fecaca", color="#f87171", fontsize=12,
           width=3.0, height=0.9, fixedsize=true];
  op_b_mux [pos="680,160!",
            label="Operand B mux\nuse_imm ? imm : fwd_rs2",
            fillcolor="#fecaca", color="#f87171", fontsize=12,
            width=2.4, height=0.9, fixedsize=true];
  muldiv [pos="960,160!",
          label="kronos_muldiv\nmulti-cycle MUL/DIV",
          fillcolor="#fecaca", color="#f87171", fontsize=13,
          width=2.2, height=0.9, fixedsize=true];

  // ── Result mux (between ALU and MULDIV result paths) ────────────
  res_mux [pos="1160,300!",
           label="Result mux\nis_muldiv ?\nmuldiv_res : alu_res",
           fillcolor="#fecaca", color="#f87171", fontsize=12,
           width=2.4, height=1.0, fixedsize=true];

  // ── Branch resolution (ALU lane, east of ALU, y=440) ────────────
  branch [pos="1440,440!",
          label="Branch resolution\ncomparator + mispredict",
          fillcolor="#fecaca", color="#f87171", fontsize=12,
          width=2.6, height=0.9, fixedsize=true];

  // ── CSR / Trap lane (y=40) ───────────────────────────────────────
  trap [pos="960,40!",
        label="Trap priority\nirq > illegal > ecall > ebreak",
        fillcolor="#fecaca", color="#f87171", fontsize=12,
        width=2.6, height=0.9, fixedsize=true];
  csr  [pos="1200,40!",
        label="kronos_csr\ntraps / MRET / IRQ",
        fillcolor="#fecaca", color="#f87171", fontsize=13,
        width=2.2, height=0.9, fixedsize=true];

  // ── ID/EX fan-out ────────────────────────────────────────────────
  // Register data (rs1, rs2) feed the forwarding muxes.
  // All other ID/EX outputs (PC, imm, op, csr_addr, exc_bits) are
  // carried implicitly — control signal wires are omitted for clarity.
  id_ex_reg -> fwd_rs1 [tailport=n, headport=w];
  id_ex_reg -> fwd_rs2 [tailport=s, headport=w];

  // ── Forwarding inputs (dashed) ───────────────────────────────────
  ex_mem_fwd -> fwd_rs1 [color="#ef4444", style=dashed,
                          penwidth=2, tailport=e, headport=w];
  ex_mem_fwd -> fwd_rs2 [color="#ef4444", style=dashed,
                          penwidth=2, tailport=e, headport=w];
  mem_wb_fwd -> fwd_rs1 [color="#a855f7", style=dashed,
                          penwidth=2, tailport=e, headport=w];
  mem_wb_fwd -> fwd_rs2 [color="#a855f7", style=dashed,
                          penwidth=2, tailport=e, headport=w];

  // ── ALU lane datapath ────────────────────────────────────────────
  fwd_rs1  -> op_a_mux [tailport=e, headport=w];
  op_a_mux -> alu      [tailport=e, headport=w];
  alu      -> res_mux  [tailport=s, headport=n];

  // ALU → branch: horizontal along ALU lane (both at y=440)
  alu -> branch [tailport=e, headport=w];

  // ── MULDIV lane datapath ─────────────────────────────────────────
  fwd_rs2  -> op_b_mux [tailport=e, headport=w];
  op_b_mux -> muldiv   [tailport=e, headport=w];
  muldiv   -> res_mux  [tailport=n, headport=s];

  // ── CSR / trap path ──────────────────────────────────────────────
  trap -> csr [tailport=e, headport=w];

  // ── Outputs to EX/MEM register ───────────────────────────────────
  res_mux -> ex_mem_reg [tailport=e, headport=w];
  branch  -> ex_mem_reg [tailport=s, headport=n];
  csr     -> ex_mem_reg [tailport=e, headport=s];

  // ── Branch redirect → IF PC (dashed red) ─────────────────────────
  branch -> pc_reg [color="#dc2626", style=dashed,
                    penwidth=2, tailport=e, headport=w];
}
