digraph if_align_states {
  // ────────────────────────────────────────────────────────────────
  // IF Stage — Alignment Unit FSM (kronos_align, 4 states).
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  // Transition labels pinned as plaintext to avoid xlabel collisions.
  //
  //   Row y=420: NORMAL → BUFFERED ↔ NEED_UPPER
  //   Row y=140: SKIP_LOWER (flush-path side state)
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 18,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 13,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="680,600!", label="IF Stage — Alignment Unit FSM (kronos_align)",
         shape=plaintext, style="", fontsize=22, fontcolor="#111827"];

  // Reset
  reset [pos="60,420!", label="reset / flush\npc_offset=0",
         fillcolor="#f5f5f5", color="#9ca3af", fontsize=13,
         width=1.4, height=0.7, fixedsize=true];

  // States (top row)
  NORMAL     [pos="280,420!", label="NORMAL\nbuf_valid = 0",
              shape=box, style="filled,rounded", fillcolor="#bbf7d0", color="#22c55e",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];
  BUFFERED   [pos="680,420!", label="BUFFERED\nbuf_valid = 1",
              shape=box, style="filled,rounded", fillcolor="#bfdbfe", color="#3b82f6",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];
  NEED_UPPER [pos="1080,420!", label="NEED_UPPER\nbuf + need_upper",
              shape=box, style="filled,rounded", fillcolor="#fecaca", color="#ef4444",
              penwidth=3, fontsize=16,
              width=2.3, height=1.2, fixedsize=true];

  // SKIP_LOWER (bottom row, under BUFFERED)
  SKIP_LOWER [pos="680,140!", label="SKIP_LOWER\nskip_lower_q",
              shape=box, style="filled,rounded", fillcolor="#fef9c3", color="#eab308",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];

  // State descriptions (small plaintext below each state)
  normal_desc [pos="280,300!",
               label="Use rdata directly.\nFetch required.",
               shape=plaintext, style="", fontsize=12, fontcolor="#166534"];
  needup_desc [pos="1080,300!",
               label="buf holds lower 16b of 32b instr.\nWaiting for next word.",
               shape=plaintext, style="", fontsize=12, fontcolor="#7f1d1d"];
  skip_desc [pos="680,60!",
             label="Post-flush halfword-align. Skip rdata[15:0], buffer upper.  instr_valid=0 this cycle.",
             shape=plaintext, style="", fontsize=12, fontcolor="#713f12"];

  // Pinned transition labels — top row
  lbl_n_to_b [pos="480,460!", label="rvalid & rdata[1:0]!=11\n(16b at lower half)",
              shape=plaintext, style="", fontsize=12, fontcolor="#1e3a8a"];
  lbl_b_to_n [pos="480,380!", label="buf[1:0]!=11\n(emit buf as 16b)",
              shape=plaintext, style="", fontsize=12, fontcolor="#166534"];
  lbl_b_to_u [pos="880,460!", label="buf[1:0]==11\n(spanning 32b)",
              shape=plaintext, style="", fontsize=12, fontcolor="#7f1d1d"];
  lbl_u_to_b [pos="880,380!", label="rvalid (combine halves)",
              shape=plaintext, style="", fontsize=12, fontcolor="#1e3a8a"];

  // Pinned transition labels — flush paths (vertical arrows to SKIP_LOWER)
  lbl_flush_n [pos="340,260!", label="flush &\npc_offset=1",
               shape=plaintext, style="", fontsize=11, fontcolor="#9a3412"];
  lbl_flush_b [pos="700,260!", label="flush &\npc_offset=1",
               shape=plaintext, style="", fontsize=11, fontcolor="#9a3412"];
  lbl_flush_u [pos="1020,260!", label="flush &\npc_offset=1",
               shape=plaintext, style="", fontsize=11, fontcolor="#9a3412"];
  lbl_skip_b  [pos="800,260!", label="rvalid\n(buffer upper)",
               shape=plaintext, style="", fontsize=11, fontcolor="#1e3a8a"];

  // Output summary table — placed below the diagram, centered.
  outputs [pos="680,-80!",
           shape=plaintext, style="",
           label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
  <TR>
    <TD BGCOLOR="#f3e8ff"><B>State</B></TD>
    <TD BGCOLOR="#f3e8ff"><B>instr_valid</B></TD>
    <TD BGCOLOR="#f3e8ff"><B>is_16b</B></TD>
    <TD BGCOLOR="#f3e8ff"><B>needs_fetch</B></TD>
  </TR>
  <TR><TD>NORMAL</TD><TD>rvalid</TD><TD>rdata[1:0]!=11</TD><TD>1</TD></TR>
  <TR><TD>BUFFERED</TD><TD>1 (if 16b)</TD><TD>1</TD><TD>0</TD></TR>
  <TR><TD>NEED_UPPER</TD><TD>rvalid</TD><TD>0</TD><TD>1</TD></TR>
  <TR><TD>SKIP_LOWER</TD><TD>0</TD><TD>—</TD><TD>1</TD></TR>
</TABLE>>];

  // ── Transitions — bidirectional pairs use separate upper/lower
  //    lanes; flush edges from the outer states enter SKIP_LOWER from
  //    its left/right faces so they don't cross the BUFFERED↔SKIP_LOWER
  //    vertical arrow.
  reset      -> NORMAL     [color="#6b7280",  tailport=e,  headport=w];

  NORMAL     -> BUFFERED   [color="#3b82f6",  tailport=ne, headport=nw];
  BUFFERED   -> NORMAL     [color="#22c55e",  tailport=sw, headport=se, constraint=false];
  BUFFERED   -> NEED_UPPER [color="#ef4444",  tailport=ne, headport=nw];
  NEED_UPPER -> BUFFERED   [color="#3b82f6",  tailport=sw, headport=se, constraint=false];

  // Flush edges to SKIP_LOWER (dashed orange) — route around BUFFERED.
  NORMAL     -> SKIP_LOWER [color="#f97316", style=dashed, tailport=s, headport=w,  constraint=false];
  BUFFERED   -> SKIP_LOWER [color="#f97316", style=dashed, tailport=sw, headport=nw, constraint=false];
  NEED_UPPER -> SKIP_LOWER [color="#f97316", style=dashed, tailport=s, headport=e,  constraint=false];

  SKIP_LOWER -> BUFFERED   [color="#3b82f6", tailport=ne, headport=se];
}
