digraph id_stage {
  // ────────────────────────────────────────────────────────────────
  // ID Stage — decoder, regfile, WB→ID bypass mux.
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  //
  // Symmetric layout:
  //   Pipeline axis runs horizontally at y=300.
  //   decode and regfile are mirrored about the axis (Δy = ±120).
  //   Internal column is centered between IF/ID and ID/EX (Δx = 320).
  //   Bypass chain (bypass_mux → WB stage) sits directly below ID/EX.
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 18,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 14,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="580,600!", label="ID Stage — Decode, Regfile, WB→ID Bypass",
         shape=plaintext, style="", fontsize=22, fontcolor="#14532d"];

  // Group label
  id_label [pos="580,520!", label="ID Stage",
            shape=plaintext, style="", fontsize=22, fontcolor="#14532d"];

  // ── Pipeline axis (y=300) ───────────────────────────────────────
  if_id_reg [pos="80,300!", label="IF/ID",
             fillcolor="#9ca3af", color="#6b7280", fontsize=18,
             width=1.2, height=0.7, fixedsize=true];
  id_ex_reg [pos="1080,300!", label="ID/EX",
             fillcolor="#9ca3af", color="#6b7280", fontsize=18,
             width=1.2, height=0.7, fixedsize=true];

  // ── ID internals (mirrored about y=300) ────────────────────────
  decode  [pos="580,440!", label="kronos_decode\nRV32IMC decoder\n(control + imm)",
           fillcolor="#bbf7d0", color="#4ade80", fontsize=15,
           width=2.6, height=1.1, fixedsize=true];
  regfile [pos="580,160!", label="kronos_regfile\n32×32b async read\n(rs1, rs2)",
           fillcolor="#bbf7d0", color="#4ade80", fontsize=15,
           width=2.6, height=1.1, fixedsize=true];

  // ── Bypass chain (below ID/EX, centered under it) ──────────────
  bypass_mux [pos="1080,140!", label="WB → ID bypass mux\nsel = wb_wen & (rd == rs)",
              fillcolor="#bbf7d0", color="#4ade80", fontsize=14,
              width=3.0, height=1.1, fixedsize=true];
  wb_result  [pos="1080,0!", label="WB stage\nwb_result / wb_wen / rd",
              fillcolor="#f3e8ff", color="#a855f7", fontsize=15,
              width=2.8, height=1.0, fixedsize=true];

  // ── Edges (unlabeled — color + box labels carry meaning) ──────
  if_id_reg  -> decode  [tailport=e, headport=w];
  if_id_reg  -> regfile [tailport=e, headport=w];
  decode     -> regfile [tailport=s, headport=n];
  regfile    -> bypass_mux [tailport=e, headport=w];
  decode     -> id_ex_reg  [tailport=e, headport=w];
  bypass_mux -> id_ex_reg  [tailport=n, headport=s];

  // WB bypass (dashed purple) — enters bypass_mux from south
  wb_result -> bypass_mux [color="#a855f7", style=dashed, tailport=n, headport=s];
}
