digraph mem_lsu_fsm {
  // ────────────────────────────────────────────────────────────────
  // MEM Stage — LSU AXI4 FSM (7 states).
  // Layout: neato -n2 (pinned positions, orthogonal routing).
  // Transition labels pinned as plaintext to avoid xlabel collisions.
  //
  //   Top row (y=520):    LOAD path  — LOAD_ADDR → LOAD_DATA → LOAD_DONE
  //   Mid row (y=340):    IDLE
  //   Bot row (y=140):    STORE path — STORE_SEND → STORE_RESP → STORE_DONE
  // ────────────────────────────────────────────────────────────────
  graph [
    splines     = ortho,
    pad         = 0.3,
    outputorder = edgesfirst,
    fontname    = "Helvetica",
  ];

  node [
    shape    = box,
    style    = "filled,rounded",
    fontname = "Helvetica",
    fontsize = 18,
    penwidth = 2,
  ];

  edge [
    fontname = "Helvetica",
    fontsize = 14,
    penwidth = 2,
    color    = "#111827",
  ];

  // Title
  title [pos="700,670!", label="MEM Stage — LSU AXI4 FSM",
         shape=plaintext, style="", fontsize=24, fontcolor="#7c2d12"];

  // Reset
  reset [pos="60,340!", label="rst_ni",
         fillcolor="#f5f5f5", color="#9ca3af", fontsize=14,
         width=1.2, height=0.6, fixedsize=true];

  // IDLE (center-left)
  // Height=2.05in → east-face straight section ≈124pt (y=251.8–375.8).
  // d=124/5=24.8pt → 4 evenly-spaced east-face connection points at DOT y=351,326,301,277.
  // All four IDLE connections use tailport=e so the visible exit y equals the waypoint y.
  IDLE [pos="280,314!", label="IDLE\ncapture\naddr / wdata",
        shape=box, style="filled,rounded",fillcolor="#dcfce7", color="#22c55e",
        penwidth=3, fontsize=16,
        width=2.2, height=2.05, fixedsize=true];

  // LOAD path (top row)
  LOAD_ADDR [pos="580,520!", label="LOAD_ADDR\nar_valid = 1",
             shape=box, style="filled,rounded",fillcolor="#bbf7d0", color="#16a34a",
             penwidth=3, fontsize=16,
             width=2.2, height=1.2, fixedsize=true];
  LOAD_DATA [pos="900,520!", label="LOAD_DATA\nr_ready = 1",
             shape=box, style="filled,rounded",fillcolor="#bbf7d0", color="#15803d",
             penwidth=3, fontsize=16,
             width=2.2, height=1.2, fixedsize=true];
  LOAD_DONE [pos="1220,520!", label="LOAD_DONE\nvalid_o = 1\nlatch rdata",
             shape=box, style="filled,rounded",fillcolor="#dcfce7", color="#16a34a",
             penwidth=3, fontsize=16,
             width=2.2, height=1.2, fixedsize=true];

  // STORE path (bottom row)
  STORE_SEND [pos="580,160!", label="STORE_SEND\naw_valid = 1\nw_valid = 1",
              shape=box, style="filled,rounded",fillcolor="#fed7aa", color="#f97316",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];
  STORE_RESP [pos="900,160!", label="STORE_RESP\nb_ready = 1",
              shape=box, style="filled,rounded",fillcolor="#fed7aa", color="#ea580c",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];
  STORE_DONE [pos="1220,160!", label="STORE_DONE\nvalid_o = 1",
              shape=box, style="filled,rounded",fillcolor="#ffedd5", color="#f97316",
              penwidth=3, fontsize=16,
              width=2.2, height=1.2, fixedsize=true];

  // Pinned transition labels — LOAD path (above horizontal arrow, at y=540)
  lbl_load_addr [pos="470,371!", label="req & ~is_store",
                 shape=plaintext, style="", fontsize=13, fontcolor="#166534"];
  lbl_ar_ready  [pos="740,540!", label="ar_ready",
                 shape=plaintext, style="", fontsize=13, fontcolor="#166534"];
  lbl_r_valid   [pos="1060,540!", label="r_valid",
                 shape=plaintext, style="", fontsize=13, fontcolor="#166534"];
  lbl_load_back [pos="900,346!", label="always (return to IDLE)",
                 shape=plaintext, style="", fontsize=13, fontcolor="#166534"];

  // Pinned transition labels — STORE path
  lbl_store     [pos="470,257!", label="req & is_store",
                 shape=plaintext, style="", fontsize=13, fontcolor="#9a3412"];
  lbl_aw_w      [pos="740,100!", label="aw_ready & w_ready",
                 shape=plaintext, style="", fontsize=13, fontcolor="#9a3412"];
  lbl_b_valid   [pos="1060,100!", label="b_valid",
                 shape=plaintext, style="", fontsize=13, fontcolor="#9a3412"];
  lbl_store_back[pos="900,281!", label="always (return to IDLE)",
                 shape=plaintext, style="", fontsize=13, fontcolor="#9a3412"];

  // Four waypoints place the L-bend for each of the four IDLE east-face connections.
  // x=580 aligns the bend directly above/below LOAD_ADDR and STORE_SEND.
  // y values are the four evenly-spaced points on IDLE's east face (d=24.8pt each):
  //   wp_la: p4=351 (LOAD outgoing, top)
  //   wp_ld: p3=326 (LOAD_DONE return)
  //   wp_sd: p2=301 (STORE_DONE return)
  //   wp_ss: p1=277 (STORE outgoing, bottom)
  wp_la [pos="580,351!", style=invis, label="", shape=point, width=0.01, height=0.01];
  wp_ss [pos="580,277!", style=invis, label="", shape=point, width=0.01, height=0.01];

  // wp_ld / wp_sd: bend points for return arrows; x=1220 centres each arrowhead on
  // LOAD_DONE/STORE_DONE east faces, then path runs horizontally back to IDLE:e.
  wp_ld [pos="1220,326!", style=invis, label="", shape=point, width=0.01, height=0.01];
  wp_sd [pos="1220,301!", style=invis, label="", shape=point, width=0.01, height=0.01];

  // Edges — compass ports center each arrow on a bubble's N/S/E/W midpoint.
  reset -> IDLE [color="#6b7280", tailport=e, headport=w];

  // LOAD path (top row) — leave IDLE east face at p4 (y=351), go right to x=580,
  // turn up to LOAD_ADDR south face; return horizontally at p3 (y=326).
  IDLE       -> wp_la    [color="#22c55e", penwidth=3, tailport=e, arrowhead=none];
  wp_la      -> LOAD_ADDR [color="#22c55e", penwidth=3, headport=s];
  LOAD_ADDR  -> LOAD_DATA [color="#16a34a", penwidth=3, tailport=e, headport=w];
  LOAD_DATA  -> LOAD_DONE [color="#15803d", penwidth=3, tailport=e, headport=w];
  LOAD_DONE  -> wp_ld [color="#22c55e", penwidth=3, constraint=false, arrowhead=none];
  wp_ld      -> IDLE  [color="#22c55e", penwidth=3, headport=e];

  // STORE path (bottom row) — leave IDLE east face at p1 (y=277), go right to x=580,
  // turn down to STORE_SEND north face; return horizontally at p2 (y=301).
  IDLE       -> wp_ss      [color="#f97316", penwidth=3, tailport=e, arrowhead=none];
  wp_ss      -> STORE_SEND [color="#f97316", penwidth=3, headport=n];
  STORE_SEND -> STORE_RESP [color="#ea580c", penwidth=3, tailport=e, headport=w];
  STORE_RESP -> STORE_DONE [color="#dc2626", penwidth=3, tailport=e, headport=w];
  STORE_DONE -> wp_sd [color="#f97316", penwidth=3, constraint=false, arrowhead=none];
  wp_sd      -> IDLE  [color="#f97316", penwidth=3, headport=e];
}
